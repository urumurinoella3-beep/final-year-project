@startuml DQIMS_Activity_DataValidation
!theme plain
skinparam activityBackgroundColor #F3E5F5
skinparam activityBorderColor #9C27B0
skinparam activityStartColor #6A1B9A
skinparam activityEndColor #2E7D32

title Activity Diagram: Data Validation Workflow

|User (Staff/HOD)|
start
:Login to System;
:Navigate to Data Validation;

:Click "Upload File";

:Select File from Computer;
note right
  Supported formats:
  - CSV (.csv)
  - Excel (.xlsx)
  - PDF (.pdf)
  - Word (.docx)
end note

|System|
:Receive File Upload;

if (File format valid?) then (yes)
  :Save File to Server;
  :Create Validation Session;
  
  if (File type = CSV or Excel?) then (yes)
    :Parse File Content;
    :Extract Data Rows;
    
    :Initialize Counters;
    note right
      - totalRecords = 0
      - passedRecords = 0
      - failedRecords = 0
    end note
    
    partition "Validation Loop" {
      repeat
        :Read Next Row;
        :totalRecords++;
        
        :Validate Row Data;
        note right
          Check for:
          - Missing values
          - Invalid formats
          - Data type mismatches
          - Business rule violations
        end note
        
        if (Row Valid?) then (yes)
          :passedRecords++;
        else (no)
          :failedRecords++;
          :Create ValidationError Record;
          note right
            - Row number
            - Error type
            - Field name
            - Description
            - Invalid value
          end note
        endif
        
      repeat while (More rows?) is (yes)
      ->no;
    }
    
    :Save Validation Session;
    :Calculate Success Rate;
    
    |User (Staff/HOD)|
    :Display Validation Results;
    note right
      - Total records
      - Passed records
      - Failed records
      - Success percentage
    end note
    
    :View Error Details Table;
    
    if (Errors found?) then (yes)
      :Review Error List;
      
      if (Create issue from errors?) then (yes)
        :Click "Create Issue";
        :Pre-fill Issue Form;
        note right
          - Title: "Data Validation Errors"
          - Description: Error summary
          - Attach validation report
        end note
        
        |System|
        :Create New Issue;
        :Link Validation Session;
        :Notify HOD;
        
        |User (Staff/HOD)|
        :Display Issue Created;
      else (no)
        :Export Validation Report;
      endif
    else (no)
      :Display Success Message;
    endif
    
  else (PDF or Word)
    :Perform Limited Validation;
    note right
      - File integrity check
      - Basic format validation
      - No detailed content validation
    end note
    
    |User (Staff/HOD)|
    :Display Limited Validation Message;
    :File Uploaded Successfully;
  endif
  
else (no)
  |User (Staff/HOD)|
  :Display Error Message;
  note right
    "Unsupported file format.
    Please upload CSV, Excel,
    PDF, or Word files."
  end note
  stop
endif

:Option to Download Report;
stop

@enduml
