@startuml DQIMS_Activity_IssueReporting
!theme plain
skinparam activityBackgroundColor #E8F5E9
skinparam activityBorderColor #4CAF50
skinparam activityStartColor #2E7D32
skinparam activityEndColor #C62828

title Activity Diagram: Issue Reporting Workflow

|Staff/HOD|
start
:Login to System;
:Navigate to Issue Management;
:Click "Report New Issue";

:Fill Issue Details;
note right
  - Title
  - Description
  - Source
  - Data Element
  - Issue Type
  - Severity
  - Priority
  - Department
end note

:Upload Attachments\n(Optional);

if (All required fields filled?) then (yes)
  :Submit Issue;
  
  |System|
  :Validate Input Data;
  
  if (Validation successful?) then (yes)
    :Generate Issue ID;
    :Set Status = OPEN;
    :Set Reporter = Current User;
    :Save Issue to Database;
    :Create Audit Log Entry;
    
    if (Department has HOD?) then (yes)
      :Create Notification for HOD;
      :Send Email to HOD;
    else (no)
      :Create Notification for Admin;
    endif
    
    |Staff/HOD|
    :Display Success Message;
    :Show Issue Details;
    
  else (no)
    :Display Validation Errors;
    stop
  endif
  
else (no)
  :Display Required Field Errors;
  stop
endif

:View Created Issue;
stop

@enduml
