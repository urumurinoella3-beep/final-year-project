@startuml DQIMS_Activity_UserManagement
!theme plain
skinparam activityBackgroundColor #FFEBEE
skinparam activityBorderColor #F44336
skinparam activityStartColor #C62828
skinparam activityEndColor #2E7D32

title Activity Diagram: User Management Workflow (Admin)

|Admin|
start
:Login to System;
:Navigate to User Management;

:Click "Create New User";

:Fill User Details Form;
note right
  Required fields:
  - Employee ID
  - Full Name
  - Email
  - Phone
  - Role (ADMIN/HOD/STAFF)
  - Department
end note

if (All fields valid?) then (yes)
  
  |System|
  :Validate Input Data;
  
  if (Email unique?) then (yes)
    if (Employee ID unique?) then (yes)
      
      :Generate Random Password;
      note right
        8-character alphanumeric
        password generated
      end note
      
      :Hash Password;
      :Create User Record;
      note right
        - Set isActive = true
        - Set isFirstLogin = true
        - Save to database
      end note
      
      :Create Audit Log;
      note right
        Action: "User Created"
        Entity: User ID
        Performed by: Admin
      end note
      
      :Prepare Welcome Email;
      note right
        Subject: "Welcome to DQIMS"
        Content:
        - Login credentials
        - Employee ID
        - Temporary password
        - System URL
        - Instructions
      end note
      
      :Send Email via SMTP;
      note right
        Gmail SMTP
        urumurinoella3@gmail.com
      end note
      
      if (Email sent successfully?) then (yes)
        |Admin|
        :Display Success Message;
        :Show User Details;
        note right
          "User created successfully.
          Credentials sent to email."
        end note
        
        :View Updated User List;
        
      else (no)
        |Admin|
        :Display Warning;
        note right
          "User created but email failed.
          Please share credentials manually."
        end note
        
        :Show Generated Password;
      endif
      
    else (no - Duplicate Employee ID)
      |Admin|
      :Display Error;
      note right
        "Employee ID already exists"
      end note
      stop
    endif
    
  else (no - Duplicate Email)
    |Admin|
    :Display Error;
    note right
      "Email already registered"
    end note
    stop
  endif
  
else (no)
  |Admin|
  :Display Validation Errors;
  stop
endif

' Update User Flow
|Admin|
:Select User to Update;
:Modify User Details;

if (Confirm Update?) then (yes)
  |System|
  :Update User Record;
  :Create Audit Log;
  
  if (Role or Department changed?) then (yes)
    :Send Notification Email;
  endif
  
  |Admin|
  :Display Update Success;
else (no)
  :Cancel Update;
endif

' Deactivate User Flow
|Admin|
:Select User to Deactivate;
:Click "Deactivate";

if (Confirm Deactivation?) then (yes)
  |System|
  :Set isActive = false;
  :Revoke Active Sessions;
  :Create Audit Log;
  
  |Admin|
  :Display Deactivation Success;
  :User Removed from Active List;
else (no)
  :Cancel Deactivation;
endif

stop

@enduml
