@startuml DQIMS_System_Architecture_Layered
!theme plain
skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center

title Data Quality Issues Management System (DQIMS)\nSystem Architecture - Layered View

' Backend Container
package "Backend" <<Rectangle>> #F5F5F5 {
    
    ' Database Layer
    package "Database" <<Rectangle>> #FFFFFF {
        rectangle "MySQL Database\nStores All DQIMS Data" #C8E6C9 {
            note as dbTables
                • users (Admin, HOD, Staff)
                • departments
                • issues
                • issue_comments
                • issue_attachments
                • notifications
                • audit_logs
                • password_history
                • validation_sessions
                • validation_errors
            end note
        }
    }
    
    ' Business Services Layer
    package "Business Services" <<Rectangle>> #FFFFFF {
        rectangle "Core Services\nApplication Business Logic" #FFF9C4 {
            note as coreServices
                • User Management Service
                • Issue Management Service
                • Department Management Service
                • Assignment & Workflow Service
                • Notification & Alert Service
                • Report Generation Service
                • Data Validation Service
                • Email Service
            end note
        }
    }
    
    ' Web Server Layer
    package "Web Server" <<Rectangle>> #FFFFFF {
        rectangle "Spring Boot Backend\nContains App Logic" #E1F5FE {
            note as springBoot
                • Spring Security + JWT Authentication
                • Password Management
                • Role-Based Access Control (RBAC)
                • REST API Controllers
                • Java, Spring Boot Framework
            end note
        }
    }
}

' External Systems
package "External Systems" <<Rectangle>> #F5F5F5 {
    rectangle "External Services" #F3E5F5 {
        note as externalServices
            • Gmail SMTP Server
            • Email Service Provider
            • File Storage System
        end note
    }
}

' Users
package "Users" <<Rectangle>> #F5F5F5 {
    rectangle "DQIMS Users" #FFE0B2 {
        note as users
            • Admin
            • HOD (Head of Department)
            • Staff
        end note
    }
}

' Frontend
package "Frontend" <<Rectangle>> #F5F5F5 {
    rectangle "React Frontend\nWhat Users See & Interact With" #E8F5E9 {
        note as frontend
            • Login & Authentication
            • Issue Management
            • User Management
            • Department Management
            • Data Validation
            • Reporting & Analytics
            • Notification Center
            • Dashboard
            (React.js)
        end note
    }
}

' Connections
"MySQL Database\nStores All DQIMS Data" -up-> "Core Services\nApplication Business Logic"
"Core Services\nApplication Business Logic" -up-> "Spring Boot Backend\nContains App Logic"
"Spring Boot Backend\nContains App Logic" -right-> "External Services" : Email / APIs
"Spring Boot Backend\nContains App Logic" -down-> "React Frontend\nWhat Users See & Interact With" : HTTP Requests\nJSON Responses
"DQIMS Users" -down-> "React Frontend\nWhat Users See & Interact With" : Login / Access\nDisplay Results
"External Services" -down-> "React Frontend\nWhat Users See & Interact With" : HTTP Requests\nJSON Responses

@enduml
