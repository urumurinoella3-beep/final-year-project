@startuml DQIMS_Activity_IssueAssignment
!theme plain
skinparam activityBackgroundColor #FFF3E0
skinparam activityBorderColor #FF9800
skinparam activityStartColor #E65100
skinparam activityEndColor #C62828

title Activity Diagram: Issue Assignment Workflow

|HOD|
start
:Login to System;
:View Department Issues;

:Select Issue to Assign;
:Click on Issue Details;

if (Issue Status = OPEN?) then (yes)
  :View Available Staff\nin Department;
  
  :Select Staff Member;
  
  if (Confirm Assignment?) then (yes)
    
    |System|
    :Update Issue Record;
    note right
      - Set assignedTo = Selected Staff
      - Keep Status = OPEN
      - Update timestamp
    end note
    
    :Create Audit Log;
    note right
      Action: "Issue Assigned"
      Entity: Issue ID
      User: HOD
      Details: Staff assigned
    end note
    
    :Create Notification;
    note right
      Type: ISSUE_ASSIGNED
      Recipient: Assigned Staff
      Message: "New issue assigned to you"
    end note
    
    :Send Email to Staff;
    note right
      Subject: "New Issue Assigned"
      Content: Issue details & link
    end note
    
    |HOD|
    :Display Success Message;
    :Update Issue List;
    
  else (no)
    :Cancel Assignment;
    stop
  endif
  
else (no - Already Assigned)
  if (Reassign to different staff?) then (yes)
    :Select New Staff Member;
    
    |System|
    :Update Assignment;
    :Create Notification for New Staff;
    :Create Notification for Previous Staff;
    :Send Emails;
    
    |HOD|
    :Display Reassignment Success;
  else (no)
    :View Current Assignment;
    stop
  endif
endif

:View Updated Issue;
stop

@enduml
