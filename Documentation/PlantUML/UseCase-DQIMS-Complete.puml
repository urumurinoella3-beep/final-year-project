@startuml DQIMS-Complete-UseCase
!theme cerulean-outline
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Data Quality Issues Management System (DQIMS)\nComplete Use Case Diagram

' Define Actors
actor "Staff Member\n(Reporter)" as Staff #lightblue
actor "HOD\n(Head of Department)" as HOD #lightgreen
actor "System Admin" as Admin #orange
actor "Data Validator" as Validator #pink

' System boundary
package "DQIMS Platform" {
    
    ' ===== AUTHENTICATION & PROFILE =====
    package "Account Management" #f0f0f0 {
        usecase (UC01: Register Account) as UC01
        usecase (UC02: Login to System) as UC02
        usecase (UC03: Update Profile) as UC03
        usecase (UC04: Change Password) as UC04
        usecase (UC05: Logout) as UC05
    }
    
    ' ===== ISSUE MANAGEMENT =====
    package "Issue Management" #e8f5e9 {
        usecase (UC06: Report Issue) as UC06
        usecase (UC07: View Issues) as UC07
        usecase (UC08: Update Issue) as UC08
        usecase (UC09: Assign Issue) as UC09
        usecase (UC10: Close Issue) as UC10
        usecase (UC11: Add Comment) as UC11
        usecase (UC12: Track Issue Status) as UC12
    }
    
    ' ===== DATA VALIDATION =====
    package "Data Validation" #fff3e0 {
        usecase (UC13: Upload Data File) as UC13
        usecase (UC14: Validate Data) as UC14
        usecase (UC15: View Validation\nResults) as UC15
        usecase (UC16: Export Errors) as UC16
        usecase (UC17: View Validation\nHistory) as UC17
    }
    
    ' ===== REPORTING & ANALYTICS =====
    package "Reports & Analytics" #e3f2fd {
        usecase (UC18: Generate PDF Report) as UC18
        usecase (UC19: Generate Excel Report) as UC19
        usecase (UC20: View Dashboard) as UC20
        usecase (UC21: Filter by Date/Time) as UC21
        usecase (UC22: View Statistics) as UC22
        usecase (UC23: View Audit Logs) as UC23
    }
    
    ' ===== DEPARTMENT MANAGEMENT =====
    package "Department Management" #fce4ec {
        usecase (UC24: Manage Departments) as UC24
        usecase (UC25: View Staff Directory) as UC25
        usecase (UC26: Assign Staff to Issue) as UC26
        usecase (UC27: View Department Stats) as UC27
    }
    
    ' ===== USER MANAGEMENT =====
    package "User Management" #fff8e1 {
        usecase (UC28: Create User) as UC28
        usecase (UC29: Update User) as UC29
        usecase (UC30: Deactivate User) as UC30
        usecase (UC31: Manage Roles) as UC31
        usecase (UC32: View User Activity) as UC32
    }
    
    ' ===== NOTIFICATIONS =====
    package "Notifications" #f3e5f5 {
        usecase (UC33: Receive Notifications) as UC33
        usecase (UC34: Mark as Read) as UC34
        usecase (UC35: View All Notifications) as UC35
    }
}

