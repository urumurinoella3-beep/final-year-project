@startuml DQIMS_UseCase_Diagram
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Data Quality Issues Management System (DQIMS)\nUse Case Diagram

' Define Actors
actor "System Admin" as Admin #LightBlue
actor "Head of Department\n(HOD)" as HOD #LightGreen
actor "Staff Member" as Staff #LightYellow
actor "Email System" as Email #LightGray

' Secondary Actors
actor "Database" as DB #WhiteSmoke
actor "File System" as FS #WhiteSmoke

' System Boundary
rectangle "DQIMS System" {
    
    ' Authentication & User Management
    package "Authentication & User Management" #DDDDDD {
        usecase "Login to System" as UC1
        usecase "Change Password" as UC2
        usecase "Reset Password" as UC3
        usecase "Logout" as UC4
        usecase "Manage User Accounts" as UC5
        usecase "Create User Account" as UC6
        usecase "Update User Account" as UC7
        usecase "Deactivate User Account" as UC8
        usecase "View User List" as UC9
    }
    
    ' Issue Management
    package "Issue Management" #E8F5E9 {
        usecase "Report New Issue" as UC10
        usecase "View Issues" as UC11
        usecase "View Issue Details" as UC12
        usecase "Assign Issue" as UC13
        usecase "Update Issue Status" as UC14
        usecase "Change Issue Priority" as UC15
        usecase "Add Comment to Issue" as UC16
        usecase "Upload Attachment" as UC17
        usecase "Download Attachment" as UC18
        usecase "Close Issue" as UC19
        usecase "Reopen Issue" as UC20
        usecase "Mark Issue as Resolved" as UC21
    }
    
    ' Department Management
    package "Department Management" #FFF3E0 {
        usecase "Create Department" as UC22
        usecase "View Departments" as UC23
        usecase "Update Department" as UC24
        usecase "Assign HOD to Department" as UC25
    }
    
    ' Data Validation
    package "Data Validation" #E3F2FD {
        usecase "Upload Data File" as UC26
        usecase "Validate Data" as UC27
        usecase "View Validation Results" as UC28
        usecase "Export Validation Report" as UC29
        usecase "Create Issue from Validation" as UC30
    }
    
    ' Reporting & Analytics
    package "Reporting & Analytics" #F3E5F5 {
        usecase "Generate Reports" as UC31
        usecase "View Dashboard" as UC32
        usecase "Export Report (PDF)" as UC33
        usecase "Export Report (Excel)" as UC34
        usecase "Export Report (CSV)" as UC35
        usecase "Export Report (Word)" as UC36
        usecase "View Issue Statistics" as UC37
        usecase "View Department Performance" as UC38
    }
    
    ' Notification Management
    package "Notification Management" #FCE4EC {
        usecase "View Notifications" as UC39
        usecase "Mark Notification as Read" as UC40
        usecase "Receive Email Notification" as UC41
        usecase "Send Assignment Notification" as UC42
    }
    
    ' Audit & Logging
    package "Audit & Logging" #EFEBE9 {
        usecase "View Audit Logs" as UC43
        usecase "Track User Activities" as UC44
        usecase "Generate Audit Report" as UC45
    }
}

