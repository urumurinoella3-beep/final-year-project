@startuml DQIMS_Deployment_Architecture
!theme plain

title DQIMS Deployment Architecture

' Client Side
node "Client Devices" as ClientNode #E3F2FD {
    component "Web Browser" as Browser #2196F3 {
        [Chrome 90+]
        [Firefox 88+]
        [Edge 90+]
        [Safari 14+]
    }
    
    component "React Application" as ReactApp #42A5F5 {
        [JavaScript Bundle]
        [CSS Styles]
        [Assets & Images]
    }
    
    database "Local Storage" as LocalStorage #1976D2 {
        [JWT Token]
        [User Preferences]
    }
    
    Browser --> ReactApp
    ReactApp --> LocalStorage
}

' Network Layer
cloud "Internet / RRA Network" as Network #E8F5E9 {
    [HTTPS Protocol]
    [Port 443]
}

ClientNode -down-> Network : HTTPS Requests

' Web Server (Optional)
node "Web Server (Optional)" as WebServerNode #FFF3E0 {
    component "Nginx" as Nginx #FF9800 {
        [Reverse Proxy]
        [Load Balancer]
        [SSL/TLS Termination]
        [Static File Serving]
        
        note right
          <b>Configuration:</b>
          • Port: 80, 443
          • SSL Certificate
          • Proxy to :8080
        end note
    }
}

Network -down-> WebServerNode : HTTPS (443)

' Application Server
node "Application Server" as AppServerNode #E8F5E9 {
    component "Spring Boot Application" as SpringBoot #4CAF50 {
        [Embedded Tomcat]
        [REST API]
        [Business Logic]
        [Security Layer]
        
        note right
          <b>Configuration:</b>
          • Port: 8080
          • JVM: Java 17
          • Memory: 2-4 GB
          • CPU: 4 cores
        end note
    }
    
    component "Application Files" as AppFiles #66BB6A {
        [JAR File]
        [application.properties]
        [Log Files]
    }
    
    SpringBoot --> AppFiles
}

WebServerNode -down-> AppServerNode : HTTP (8080)

' Database Server
node "Database Server" as DBServerNode #FFF3E0 {
    database "MySQL Server" as MySQLServer #FF9800 {
        [dqims_db]
        [10 Tables]
        [Indexes]
        [Constraints]
        
        note right
          <b>Configuration:</b>
          • Port: 3306
          • Version: MySQL 8.0
          • Storage: 100+ GB
          • Charset: UTF-8
        end note
    }
    
    component "Database Files" as DBFiles #FFB74D {
        [Data Files (.ibd)]
        [Log Files]
        [Backup Files]
    }
    
    MySQLServer --> DBFiles
}

AppServerNode -down-> DBServerNode : JDBC (3306)

' File Storage Server
node "File Storage Server" as FileServerNode #E1F5FE {
    folder "File System" as FileSystem #03A9F4 {
        folder "uploads/" {
            [Issue Attachments]
            [Validation Files]
        }
        
        folder "reports/" {
            [Generated Reports]
            [Export Files]
        }
        
        folder "temp/" {
            [Temporary Files]
        }
        
        note right
          <b>Storage:</b>
          • Path: /var/dqims/files
          • Size: 50+ GB
          • Backup: Daily
        end note
    }
}

AppServerNode -down-> FileServerNode : File I/O

' Email Server
cloud "Email Service" as EmailCloud #F3E5F5 {
    component "Gmail SMTP" as Gmail #CE93D8 {
        [smtp.gmail.com]
        [Port: 587]
        [TLS Enabled]
        
        note right
          <b>Configuration:</b>
          • From: urumurinoella3@gmail.com
          • Auth: App Password
          • Protocol: SMTP/TLS
        end note
    }
}

AppServerNode -right-> EmailCloud : SMTP (587)

' Backup Server
node "Backup Server" as BackupNode #FFEBEE {
    database "Backup Storage" as BackupStorage #EF5350 {
        [Database Backups]
        [File Backups]
        [Configuration Backups]
        
        note right
          <b>Backup Schedule:</b>
          • Full: Daily 2:00 AM
          • Incremental: Every 6 hours
          • Retention: 30 days
        end note
    }
}

DBServerNode -down-> BackupNode : Backup
FileServerNode -down-> BackupNode : Backup

' Monitoring (Optional)
node "Monitoring & Logging" as MonitorNode #E8EAF6 {
    component "Application Logs" as AppLogs #5C6BC0 {
        [Spring Boot Logs]
        [Access Logs]
        [Error Logs]
    }
    
    component "Database Logs" as DBLogs #7986CB {
        [Query Logs]
        [Error Logs]
        [Slow Query Logs]
    }
    
    component "System Monitoring" as SysMonitor #9FA8DA {
        [CPU Usage]
        [Memory Usage]
        [Disk Usage]
        [Network Traffic]
    }
}

AppServerNode -down-> MonitorNode : Log Events
DBServerNode -down-> MonitorNode : Log Events

' Deployment Summary
legend bottom left
  <b>DQIMS Deployment Architecture Summary</b>
  
  <b>Client Layer:</b>
  • Web browsers (Chrome, Firefox, Edge, Safari)
  • React application (JavaScript bundle)
  • Local storage for JWT tokens
  
  <b>Web Server Layer (Optional):</b>
  • Nginx for reverse proxy and load balancing
  • SSL/TLS termination
  • Static file serving
  
  <b>Application Server Layer:</b>
  • Spring Boot application (JAR)
  • Embedded Tomcat server
  • Port: 8080
  • Java 17 runtime
  
  <b>Database Server Layer:</b>
  • MySQL 8.0 server
  • Port: 3306
  • 10 normalized tables
  • Daily backups
  
  <b>File Storage Layer:</b>
  • File system storage
  • Issue attachments
  • Validation files
  • Generated reports
  
  <b>External Services:</b>
  • Gmail SMTP for email notifications
  • Backup server for data protection
  
  <b>Network Security:</b>
  • HTTPS encryption
  • JWT token authentication
  • Firewall rules
  • Database access restrictions
  
  <b>Scalability:</b>
  • Horizontal scaling: Multiple app servers behind load balancer
  • Vertical scaling: Increase server resources
  • Database replication: Master-slave setup (future)
endlegend

@enduml
