@startuml DQIMS_Class_Diagram
!theme plain
skinparam classBackgroundColor #FFFEF7
skinparam classBorderColor #333333
skinparam stereotypeCBackgroundColor #E8F5E9

title Data Quality Issues Management System (DQIMS)\nClass Diagram

' Enumerations
enum UserRole {
    ADMIN
    HOD
    STAFF
}

enum IssueStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED
}

enum NotificationType {
    ISSUE_ASSIGNED
    STATUS_UPDATED
    PRIORITY_CHANGED
    COMMENT_ADDED
    ISSUE_CLOSED
}

' Primary Classes
class User {
    - id: Long
    - employeeId: String
    - name: String
    - email: String
    - phone: String
    - passwordHash: String
    - role: UserRole
    - department: String
    - isActive: Boolean
    - isFirstLogin: Boolean
    - passwordResetToken: String
    - passwordResetExpiry: LocalDateTime
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    --
    + prePersist(): void
    + preUpdate(): void
}

class Issue {
    - id: Long
    - title: String
    - description: String
    - source: String
    - dataElement: String
    - issueType: String
    - severity: String
    - priority: String
    - status: IssueStatus
    - department: String
    - isDelegated: Boolean
    - delegatedFrom: String
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    - resolvedAt: LocalDateTime
    - closedAt: LocalDateTime
    --
    + prePersist(): void
    + preUpdate(): void
}

class Department {
    - id: Long
    - name: String
    - description: String
    - isActive: Boolean
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    --
    + prePersist(): void
    + preUpdate(): void
}

class Notification {
    - id: Long
    - type: NotificationType
    - title: String
    - message: String
    - isRead: Boolean
    - createdAt: LocalDateTime
    - readAt: LocalDateTime
    --
    + prePersist(): void
}

class AuditLog {
    - id: Long
    - action: String
    - entityType: String
    - entityId: Long
    - details: String
    - ipAddress: String
    - userAgent: String
    - createdAt: LocalDateTime
    --
    + prePersist(): void
}

' Secondary Classes
class IssueComment {
    - id: Long
    - content: String
    - createdAt: LocalDateTime
    - updatedAt: LocalDateTime
    - isEdited: Boolean
    --
    + prePersist(): void
    + preUpdate(): void
}

class IssueAttachment {
    - id: Long
    - fileName: String
    - filePath: String
    - fileType: String
    - fileSize: Long
    - uploadedAt: LocalDateTime
    --
    + prePersist(): void
}

class PasswordHistory {
    - id: Long
    - passwordHash: String
    - createdAt: LocalDateTime
    --
    + prePersist(): void
}

class ValidationSession {
    - id: Long
    - fileName: String
    - totalRecords: Integer
    - passedRecords: Integer
    - failedRecords: Integer
    - createdAt: LocalDateTime
    --
    + prePersist(): void
    + getSuccessRate(): Double
}

class ValidationError {
    - id: Long
    - rowNumber: Integer
    - errorType: String
    - fieldName: String
    - description: String
    - value: String
    - createdAt: LocalDateTime
    --
    + prePersist(): void
}

' Relationships

' User relationships
User "1" -- "0..*" Issue : reports >
User "1" -- "0..*" Issue : assigned to >
User "1" -- "0..*" Issue : closes >
User "1" -- "0..*" IssueComment : writes >
User "1" -- "0..*" IssueAttachment : uploads >
User "1" -- "0..*" Notification : receives >
User "1" -- "0..*" AuditLog : performs >
User "1" -- "0..*" PasswordHistory : has >
User "1" -- "0..*" ValidationSession : creates >
User "1" *-- "1" UserRole : has

' Issue relationships
Issue "1" *-- "1" IssueStatus : has
Issue "1" -- "0..*" IssueComment : contains >
Issue "1" -- "0..*" IssueAttachment : has >
Issue "0..1" -- "0..*" Notification : triggers >

' Notification relationships
Notification "1" *-- "1" NotificationType : has

' ValidationSession relationships
ValidationSession "1" -- "0..*" ValidationError : contains >

' Notes
note right of User
  <b>Primary Class</b>
  Represents system users
  with three roles:
  - ADMIN: System oversight
  - HOD: Department head
  - STAFF: Regular employee
end note

note right of Issue
  <b>Primary Class</b>
  Core entity representing
  data quality issues.
  Status workflow:
  OPEN → IN_PROGRESS
  → RESOLVED → CLOSED
end note

note right of Department
  <b>Primary Class</b>
  Organizational units
  Each department must
  have one HOD
end note

note right of Notification
  <b>Primary Class</b>
  Real-time notifications
  for issue assignments,
  status changes, and
  comments
end note

note right of AuditLog
  <b>Primary Class</b>
  Tracks all system
  activities for
  compliance and
  security monitoring
end note

note right of IssueComment
  <b>Secondary Class</b>
  Supports collaboration
  through threaded
  discussions on issues
end note

note right of IssueAttachment
  <b>Secondary Class</b>
  Stores file references
  for issue documentation
  (CSV, Excel, PDF, Word)
end note

note right of PasswordHistory
  <b>Secondary Class</b>
  Prevents password reuse
  for security compliance
end note

note right of ValidationSession
  <b>Secondary Class</b>
  Tracks data validation
  operations and results
end note

note right of ValidationError
  <b>Secondary Class</b>
  Details specific errors
  found during data
  validation
end note

@enduml
