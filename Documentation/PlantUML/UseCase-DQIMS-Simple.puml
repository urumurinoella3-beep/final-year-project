@startuml DQIMS-Simple-UseCase
!theme cerulean-outline
skinparam actorStyle awesome

title Data Quality Issues Management System (DQIMS)\nSimplified Use Case Diagram

' Actors
:Staff Member: as Staff
:HOD: as HOD
:Admin: as Admin

rectangle "DQIMS Core Functions" {
    
    ' Core use cases
    (Login) as Login
    (Report Issue) as Report
    (Assign Issue) as Assign
    (Resolve Issue) as Resolve
    (View Dashboard) as Dashboard
    (Generate Reports) as Reports
    (Validate Data) as Validate
    (Manage Users) as Users
    
    ' Relationships
    Staff --> Login
    Staff --> Report
    Staff --> Validate
    Staff --> Dashboard
    
    HOD --> Login
    HOD --> Assign
    HOD --> Reports
    HOD --> Dashboard
    
    Admin --> Login
    Admin --> Users
    Admin --> Reports
    Admin --> Dashboard
    
    Report ..> Assign : <<after>>
    Assign ..> Resolve : <<triggers>>
    
    note right of Report
        Staff identifies and
        documents data quality
        issues with details
    end note
    
    note right of Assign
        HOD reviews and assigns
        issues to appropriate
        team members
    end note
    
    note right of Reports
        Generate PDF/Excel reports
        with custom date/time filters
        for analysis and auditing
    end note
}

legend right
    |= Color |= Role |
    | <#lightblue> | Staff Member |
    | <#lightgreen> | HOD (Manager) |
    | <#orange> | System Admin |
endlegend

@enduml
